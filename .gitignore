# Python Cache
__pycache__/
*.pyc
*.pyo
**/__pycache__/
*.egg-info/
dist/
build/

# Environments & Virtual Environments
backend/.venv/
.venv/
venv/
env/

# Secrets & Environment Files — NEVER COMMIT THESE
.env
.env.*
backend/.env
backend/.env.production
!.env.example

# Uploads (user-generated content — stays on server)
backend/uploads/
uploads/

# Logs
*.log
logs/

# SQLite (legacy — should never be in production)
*.db
*.sqlite3

# OS / Editor
.DS_Store
Thumbs.db
.vscode/settings.json

# Node (if any frontend tooling)
node_modules/
backups/

# TLS material. The live cert lives in the letsencrypt volume; these were a
# stale June copy that got committed — a private key has no business in a repo,
# even a private one, and tracking the directory means the next renewal copied
# here would be committed too.
ssl/
