# ╔══════════════════════════════════════════════════════════════╗
# ║  Ghawy — Production Environment Variables                    ║
# ║                                                              ║
# ║  HOW TO USE ON SERVER:                                       ║
# ║  1. Copy this file: cp .env.production.example .env.production
# ║  2. Fill in every value marked <CHANGE_ME>                   ║
# ║  3. NEVER commit .env.production to git                      ║
# ╚══════════════════════════════════════════════════════════════╝

# ── Application ────────────────────────────────────────────────
ENVIRONMENT=production

# ── Database ───────────────────────────────────────────────────
# Must match the values in docker-compose.prod.yml
DATABASE_URL=postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/<POSTGRES_DB>
POSTGRES_USER=ghawy_user
POSTGRES_PASSWORD=<CHANGE_ME_use_a_strong_password>
POSTGRES_DB=ghawy_db

# ── Security ───────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<CHANGE_ME_generate_32_byte_hex>

# ── CORS ───────────────────────────────────────────────────────
# Comma-separated list of allowed origins — NO trailing slash
# Example: https://ghawy.com,https://www.ghawy.com
ALLOWED_ORIGINS=https://<YOUR_DOMAIN>
FRONTEND_URL=https://<YOUR_DOMAIN>

# ── Kashier Payments (LIVE mode) ───────────────────────────────
KASHIER_MERCHANT_ID=<YOUR_KASHIER_MERCHANT_ID>
KASHIER_SECRET_KEY=<YOUR_KASHIER_SECRET_KEY>
KASHIER_API_KEY=<YOUR_KASHIER_API_KEY>
KASHIER_BASE_URL=https://payments.kashier.io
KASHIER_MODE=live
KASHIER_RETURN_URL=https://<YOUR_DOMAIN>/api/payment/kashier/success
KASHIER_FAILURE_URL=https://<YOUR_DOMAIN>/api/payment/kashier/fail
KASHIER_WEBHOOK_URL=https://<YOUR_DOMAIN>/api/webhooks/kashier

# ── Email (SMTP) ───────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<YOUR_GMAIL_ADDRESS>
SMTP_PASSWORD=<YOUR_GMAIL_APP_PASSWORD>
SMTP_FROM_EMAIL=<YOUR_GMAIL_ADDRESS>

# ── Google OAuth ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=<YOUR_GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<YOUR_GOOGLE_CLIENT_SECRET>

# ── BunnyCDN ───────────────────────────────────────────────────
BUNNY_API_KEY=<YOUR_BUNNY_API_KEY>

# ── Infobip SMS ───────────────────────────────────────────────
INFOBIP_API_KEY=<YOUR_INFOBIP_API_KEY>
INFOBIP_BASE_URL=<YOUR_INFOBIP_BASE_URL>
INFOBIP_SENDER=Ghawy

# ── Payment (Manual / InstaPay) ────────────────────────────────
INSTAPAY_NUMBER=<YOUR_INSTAPAY_NUMBER>
SUBSCRIPTION_PRICE=500
